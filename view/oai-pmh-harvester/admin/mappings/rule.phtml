<?php
/**
* @var rule array[mixed]
*/

if (array_key_exists('truthy-kind', $rule)) {
    $truthyOp = $rule['truthy-kind'] == 'xpath-query' 
        ? "<b>Query Value</b>" 
        : "<b>Create Value</b>"; 
} else {
    $truthyOp = '';
}

if (array_key_exists('falsy-kind', $rule)) {
    $falsyOp = $rule['falsy-kind'] == 'xpath-query' 
        ? "<b>Query Value</b>" 
        : "<b>Create Value</b>"; 
} else {
    $falsyOp = '';
}

// Render rule in pre
$ruleContent = '';
if (array_key_exists('xpath-cond', $rule) && $rule['xpath-cond']) {
    $ruleContent = $ruleContent 
        . '<b>IF</b> <span class="rule-op">' . $this->escapeHtml($rule['xpath-cond']) . '</span> <b>THEN</b></br>    ';
}

$ruleContent = $ruleContent . $truthyOp . ' : <span class="rule-op">' . $this->escapeHtml($rule['truthy-input']) . '</span></br>';

if (array_key_exists('xpath-cond', $rule) && $rule['xpath-cond']) {
    $ruleContent = $ruleContent 
        . '<b>ELSE</b></br>    ' . $falsyOp . ' : <span class="rule-op">' . $this->escapeHtml($rule['falsy-input']) . '</span> ';
}

?>
<!-- This is ugly because of the pre  --> 
<pre class='rule'><?=$ruleContent?></pre>
